{
  "description": "Readback: record intent at the start, after plan approval or before the first edit; show the board or the 'What changed' card when Claude stops with a new diff; brief Claude at session start from .readback/context.md.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/rb\" hook-start", "timeout": 10 } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/rb\" hook-prompt", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "ExitPlanMode",
        "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/rb\" hook-plan", "timeout": 15 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/rb\" hook-edit", "timeout": 10 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/rb\" hook-done", "timeout": 20 } ] }
    ]
  }
}
