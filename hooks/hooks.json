{
  "description": "Readback: record intent at the start and after plan approval; show the board when Claude stops with a new diff.",
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/bin/rb.py\" hook-prompt", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "ExitPlanMode",
        "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/bin/rb.py\" hook-plan", "timeout": 15 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python \"${CLAUDE_PLUGIN_ROOT}/bin/rb.py\" hook-done", "timeout": 20 } ] }
    ]
  }
}
